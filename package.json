{
    "name": "psg-queue-handler",
    "version": "1.0.0",
    "type": "module",
    "main": "server.js",
    "scripts": {
      "start": "node startup-log.js",
      "restart": "bash restart.sh",
      "test": "node -e \"console.log('Environment test: ' + (process.env.PORT || 'Environment variables not loaded properly'))\""
    },
    "engines": {
      "node": ">=18.0.0"
    },
    "dependencies": {
      "dotenv": "^16.0.3",
      "express": "^4.18.2",
      "puppeteer": "^22.8.2",
      "twilio": "^4.20.0"
    },
    "puppeteerOptions": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage"
      ],
      "executablePath": "/usr/bin/google-chrome-stable",
      "headless": true
    }
  }