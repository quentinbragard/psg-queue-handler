{
    "name": "psg-queue-handler",
    "version": "1.0.0",
    "type": "module",
    "main": "server.js",
    "scripts": {
        "start": "node startup-log.js",
        "restart": "bash restart.sh",
        "test": "node -e \"console.log('Environment test: ' + (process.env.PORT || 'Environment variables not loaded properly'))\""
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "dotenv": "^16.5.0",
        "express": "^4.21.2",
        "puppeteer": "^22.15.0",
        "twilio": "^4.23.0"
    },
    "puppeteerOptions": {
        "args": [
            "--no-sandbox",
            "--disable-setuid-sandbox",
            "--disable-dev-shm-usage"
        ],
        "executablePath": "/usr/bin/google-chrome-stable",
        "headless": true
    }
}
